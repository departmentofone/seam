{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seam",
  "mainBinaryName": "Seam",
  "version": "0.2.0",
  "identifier": "net.departmentofone.seam",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Seam",
        "width": 980,
        "height": 680,
        "minWidth": 760,
        "minHeight": 540,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Department of One",
    "homepage": "https://www.departmentofone.net/seam",
    "copyright": "MIT License",
    "category": "Utility",
    "shortDescription": "One mouse, keyboard and clipboard across your PCs",
    "longDescription": "Seam lets you move your mouse off the edge of one PC's screen and onto another, type on whichever one the cursor is on, and copy, paste or drag files between them. Everything stays on your local network and is encrypted.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./installer-hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  }
}
